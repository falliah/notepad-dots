URxvt*perl-ext-common: default,matcher
URxvt*matcher.button: 1
URxvt*matcher.pattern: \bX\b
URxvt*matcher.border: #ff0000
URxvt*matcher.pattern: \bX\b makes the text "X" clickable.

URxvt*backgroundPixmap: /home/ethan/Downloads/backpix.xpm;style=tiled

rxvt.answerbackString:
rxvt.insecure: false
rxvt.colorBD:
rxvt.colorUL:


URxvt.font: xft:desertedttf2:style=medium
URxvt.boldfont xft:desertedttf2:style=medium


Xcursor.theme: Yaru

! Fonts

rxvt.keysym.Shift-Control-V: eval:paste_clipboard
rxvt.keysym.Shift-Control-C: eval:selection_to_clipboard
rxvt.perl-ext-common: selection-to-clipboard

rxvt*backgroundPixmap: /home/ethan/Downloads/backpix.xpm;style=tiled


rxvt*font: xft:desertedttf2:style=medium:pixelsize=16
rxvt*boldFont: xft:desertedttf2:style=medium:pixelsize=16
rxvt.letterSpace: 1

rxvt*allowBoldFonts: false

dzen2.font: xft:deserted:size=16
dzen2.foreground: black
dzen2.background: white

! Colors

*.foreground:   #363157
*.background:   #FFF7EB

*.cursorColor:  #2D2424

! black
*.color0:       #483939
*.color8:       #9C8181

! red
*.color1:       #AE4750
*.color9:       #C8767D

! green
*.color2:       #C6695D
*.color10:      #DB9A91

! yellow
*.color3:       #CD9165
*.color11:      #D4A391

! blue
*.color4:       #97916F
*.color12:      #AFA49B

! magenta
*.color5:       #7B727E
*.color13:      #A69DA4

! cyan
*.color6:       #83546B
*.color14:      #A3728B

! white
*.color7:       #E0CFC6
*.color15:      #FFF7EB


! Misc

*internalBorder: 0
*cursorColor: #fff7eb
rxvt*externalBorder: 20
rxvt*borderWidth: 20
*scrollBar: false
*saveLines: 8000



! geometry

rxvt*geometry: 80x32
